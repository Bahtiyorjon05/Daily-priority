generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String           @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  /// AES-256-GCM encrypted copy of the password, readable by the admin dashboard.
  /// Login always verifies against `password` (bcrypt); this field is display-only.
  passwordEnc      String?
  /// When true, the user is forced to set a new password before using the app
  /// (used to capture a fresh vaulted password for every existing account).
  mustResetPassword Boolean         @default(false)
  /// When the first-run onboarding was completed. Null means the user has never
  /// been through it and should be routed there. Backfilled for accounts that
  /// existed before onboarding shipped, so nobody is sent back through it.
  onboardedAt      DateTime?
  /// Soft delete. Set when the user deletes their own account: sign-in is
  /// refused from this moment on, but the row and every related record stay so
  /// the admin console keeps a complete history. Never null-checked for
  /// authorisation anywhere except the auth layer — see `assertNotDeleted`.
  deletedAt        DateTime?
  /// Free-text reason captured at deletion time, if the user gave one.
  deletionReason   String?
  /// The address this account used, moved here when someone signs up again with
  /// it. `email` is unique, so a closed account would otherwise squat on the
  /// address forever and the person could never come back. On re-registration
  /// `email` becomes a tombstone and the real address lands here, which frees
  /// the index without touching a single row of the closed account's history.
  /// Null for every account that has not been superseded. Admin displays this
  /// in preference to `email` so the console still shows who the record was.
  deletedEmail     String?
  location         String?
  timezone         String?          @default("UTC")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  twoFactorEnabled Boolean          @default(false)
  twoFactorSecret  String?
  accounts         Account[]
  pushSubscriptions PushSubscription[]
  notificationPreference NotificationPreference?
  adhkarProgress   AdhkarProgress[]
  analytics        Analytics[]
  calendarEvents   CalendarEvent[]
  categories       Category[]
  focusSessions    FocusSession[]
  goals            Goal[]
  habits           Habit[]
  journalEntries   JournalEntry[]
  prayerTimes      PrayerTime[]
  prayerTracking   PrayerTracking[]
  sessions         Session[]
  tasks            Task[]
  twoFactorTokens  TwoFactorToken[]
  preferences      UserPreference?
  settings         UserSettings?
  passwordHistory  PasswordHistory[]
  qadaDebts        QadaDebt[]
  quranProgress    QuranProgress?
  quranReadingLog  QuranReadingLog[]
  quranSurahsRead  QuranSurahRead[]
  ramadanDays      RamadanDay[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

/// One row per password this account has ever used, newest by `createdAt`.
///
/// Same AES-256-GCM vault format as `User.passwordEnc`, so the admin console can
/// decrypt and display each one. The current password is the most recent row;
/// `passwordEnc` on the user is kept in step as a convenience.
///
/// This is deliberately reversible history. It exists because the admin design
/// of this app shows passwords, and it multiplies the blast radius of a database
/// leak accordingly — anyone with the DB dump plus PASSWORD_VAULT_KEY can read
/// every password every user has ever set, most of which are reused elsewhere.
/// `source` records what wrote the row (reset / signin / signup / change) so the
/// history reads as a timeline rather than a bare list.
model PasswordHistory {
  id          String   @id @default(cuid())
  userId      String
  passwordEnc String
  source      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

/// Qazo — prayers owed and prayers made up, one row per prayer per user.
///
/// Stored as two running totals rather than a row per prayer prayed. People
/// arrive with a debt measured in months or years and no record of it, so the
/// only honest starting point is a number they set themselves; a ledger of
/// individual makeups would be a fiction with better data structures.
///
/// `owed` only ever grows and `madeUp` only ever grows, so the remaining debt is
/// a subtraction that can be audited. Never stored as a single net figure: that
/// loses the distinction between "I have paid off 400" and "I owed 400 fewer
/// than I thought", which matters to the person keeping it.
model QadaDebt {
  id        String   @id @default(cuid())
  userId    String
  /// fajr | dhuhr | asr | maghrib | isha
  prayer    String
  owed      Int      @default(0)
  madeUp    Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, prayer])
  @@index([userId])
  @@map("qada_debts")
}

/// Where someone is in the Quran, and how far they have got overall.
///
/// One row per user. `lastSurah`/`lastAyah` is the bookmark — the thing that
/// makes reopening the app cost nothing. `pagesRead` is the running total, kept
/// separately because it must not go backwards when someone re-reads a surah or
/// jumps to Yaseen for a Friday.
model QuranProgress {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// 1-114
  lastSurah   Int      @default(1)
  /// Ayah within that surah, 1-based.
  lastAyah    Int      @default(1)
  /// Page in the Madani mushaf, so progress reads out of 604.
  lastPage    Int      @default(1)
  /// Distinct pages ever reached. Monotonic on purpose.
  pagesRead   Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quran_progress")
}

/// One row per day someone read, for the streak and the history.
///
/// Separate from QuranProgress because a streak is a question about days, not
/// about position: reading four pages in one sitting is one day, and the debt of
/// a missed day cannot be reconstructed from a bookmark.
model QuranReadingLog {
  id        String   @id @default(cuid())
  userId    String
  /// Midnight in the user's day, so one row per calendar day.
  date      DateTime
  pages     Int      @default(1)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@map("quran_reading_log")
}

/// Surahs this person has finished.
///
/// The missing piece that made "I finished this surah" feel broken. Progress was
/// only ever `pagesRead`, a running maximum — so finishing Al-Fatiha after
/// reading Al-Baqara moved nothing, updated no percentage, and left the reader
/// staring at the same screen. A completion is a fact about a surah, not about a
/// page number, and it needs its own row to be one.
///
/// `completedAt` is overwritten on a re-read rather than appended to: the
/// question this answers is "have I finished this one", and a list of every time
/// someone re-read Yaseen would answer a different question nobody asked.
model QuranSurahRead {
  id          String   @id @default(cuid())
  userId      String
  /// 1-114
  surah       Int
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, surah])
  @@index([userId])
  @@map("quran_surahs_read")
}

/// One row per day of Ramadan, per user.
///
/// Fasting and Taraweeh are tracked separately because they are separate acts —
/// someone can fast without praying Taraweeh and the reverse, and collapsing
/// them into "did Ramadan today" would answer neither question.
///
/// Keyed on the Gregorian date rather than the Ramadan day number: the Hijri day
/// depends on a moon sighting that varies by country, so the date the device was
/// on is the only key that cannot drift. `hijriDay` is stored alongside for
/// display, not for identity.
model RamadanDay {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  /// 1-30, as the app understood it that day. Display only.
  hijriDay  Int?
  fasted    Boolean  @default(false)
  taraweeh  Boolean  @default(false)
  /// Free-text note — what was hard, what to remember.
  note      String?
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date(sort: Desc)])
  @@map("ramadan_days")
}

/// Heartbeat + outcome of each scheduled job, so the admin console can show
/// whether the external scheduler is actually calling us.
model CronRun {
  id        String   @id @default(cuid())
  job       String   @unique
  lastRunAt DateTime @default(now())
  lastOk    Boolean  @default(true)
  runCount  Int      @default(0)
  /// Small JSON summary of the last run (counts, errors).
  lastResult Json?
  durationMs Int?

  @@map("cron_runs")
}

/// Captured application errors (client and server), surfaced in the admin
/// console. Self-hosted so there's no third-party dependency or bundle cost.
/// `fingerprint` groups repeats of the same fault so the list stays readable.
model ErrorLog {
  id          String   @id @default(cuid())
  fingerprint String
  level       String   @default("error")
  message     String
  stack       String?
  source      String   @default("client")
  url         String?
  userAgent   String?
  userId      String?
  /// Arbitrary extra context (route, component, ids…)
  context     Json?
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  resolved    Boolean  @default(false)

  @@unique([fingerprint])
  @@index([lastSeenAt(sort: Desc)])
  @@index([resolved, lastSeenAt(sort: Desc)])
  @@map("error_logs")
}

/// A browser/device push endpoint for background Web Push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Per-user notification preferences (which reminders to send, and when).
model NotificationPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  prayerReminders   Boolean  @default(true)
  /// Minutes before each prayer time to notify (0 = at the time).
  prayerLeadMinutes Int      @default(10)
  taskReminders     Boolean  @default(true)
  habitReminders    Boolean  @default(true)
  habitReminderHour Int      @default(20)
  weeklyReviewEmail Boolean  @default(true)
  quietHoursStart   Int?
  quietHoursEnd     Int?
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      Priority     @default(MEDIUM)
  urgent        Boolean      @default(false)
  important     Boolean      @default(false)
  estimatedTime Int?
  energyLevel   EnergyLevel?
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  userId        String
  categoryId    String?
  subtasks      Subtask[]
  category      Category?    @relation(fields: [categoryId], references: [id])
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags          Tag[]        @relation("TagToTask")

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, dueDate, priority])
  @@index([userId, priority, status])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([categoryId])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  taskId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#3B82F6")
  icon      String?
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([userId, name])
  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  tasks     Task[]   @relation("TagToTask")

  @@map("tags")
}

model Habit {
  id            String            @id @default(cuid())
  title         String
  description   String?
  frequency     HabitFrequency    @default(DAILY)
  targetDays    Int               @default(7)
  streak        Int               @default(0)
  longestStreak Int               @default(0)
  /// Streak freeze: how many "grace days" remain this month, and when they were
  /// last replenished. A single missed day consumes a freeze instead of
  /// resetting the streak to zero.
  freezesRemaining Int            @default(2)
  freezesResetAt   DateTime?
  lastFreezeUsedOn DateTime?
  userId        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  completions   HabitCompletion[]
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, frequency])
  @@map("habits")
}

model HabitCompletion {
  id      String   @id @default(cuid())
  habitId String
  date    DateTime @default(now())
  note    String?
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@map("habit_completions")
}

model Analytics {
  id                String   @id @default(cuid())
  userId            String
  date              DateTime @unique
  tasksCreated      Int      @default(0)
  tasksCompleted    Int      @default(0)
  focusTimeMinutes  Int      @default(0)
  productivityScore Float    @default(0)
  energyLevel       Float    @default(0)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("analytics")
}

model IslamicQuote {
  id        String        @id @default(cuid())
  text      String
  source    String
  category  QuoteCategory @default(GENERAL)
  author    String?
  isArabic  Boolean       @default(false)
  createdAt DateTime      @default(now())
  @@index([category])

  @@map("islamic_quotes")
}

model PrayerTime {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime
  fajr     String
  dhuhr    String
  asr      String
  maghrib  String
  isha     String
  location String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("prayer_times")
}

model PrayerTracking {
  id          String     @id @default(cuid())
  userId      String
  date        DateTime
  prayerName  PrayerName
  completedAt DateTime?
  onTime      Boolean    @default(false)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, prayerName])
  @@index([userId, date])
  @@map("prayer_tracking")
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @default(now())
  gratitude1 String?
  gratitude2 String?
  gratitude3 String?
  reflection String?
  mood       String?
  createdAt  DateTime @default(now())
  duas       String?
  goodDeeds  String?
  hijriDate  String?
  lessons    String?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("journal_entries")
}

model Goal {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String?
  category    GoalCategory @default(PERSONAL)
  target      Int
  progress    Int          @default(0)
  deadline    DateTime?
  completed   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  goalType    GoalType     @default(DUNYA)
  milestones  Json?
  status      GoalStatus   @default(IN_PROGRESS)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, goalType])
  @@map("goals")
}

model UserPreference {
  id                    String  @id @default(cuid())
  userId                String  @unique
  showHijriDate         Boolean @default(true)
  prayerReminderMinutes Int     @default(10)
  ramadanMode           Boolean @default(false)
  language              String  @default("en")
  /// Juristic school for the Asr calculation. 1 = Hanafi, 0 = Shafi'i (and
  /// Maliki/Hanbali, which agree with it here). Asr falls roughly 40-90 minutes
  /// later in the Hanafi school, so this is not a cosmetic preference — getting
  /// it wrong makes the app tell you the wrong time for a prayer.
  ///
  /// Defaults to Hanafi: the app's users are overwhelmingly in Uzbekistan and
  /// Central Asia, where that is the prevailing school. It shipped hard-coded to
  /// Shafi'i, so every existing user has been shown Asr early.
  asrSchool             Int     @default(1)
  /// Twilight convention for Fajr and Isha, as an Aladhan method id.
  /// 1 = Karachi · 2 = ISNA · 3 = Muslim World League · 13 = Diyanet (Turkey)
  /// 14 = Spiritual Administration of Muslims of Russia (Central Asia)
  ///
  /// Was hard-coded to 2 (ISNA), a North American convention using 15°/15° that
  /// is not what Central Asia uses. Selectable now, and worth checking against a
  /// local timetable rather than trusting a default.
  calculationMethod     Int     @default(14)
  /// Watermark for the qazo sweep: the last date already examined for missed
  /// prayers. Advancing it is what makes the sweep idempotent — without it,
  /// every page load would re-count the same missed prayers and the debt would
  /// climb forever.
  qadaAutoThrough       DateTime?
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model FocusSession {
  id          String   @id @default(cuid())
  userId      String
  duration    Int
  taskTitle   String?
  sessionType String   @default("work")
  completed   Boolean  @default(true)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date(sort: Desc)])
  @@index([userId, completed, date(sort: Desc)])
  @@index([userId, sessionType, completed])
  @@map("focus_sessions")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  date        DateTime
  hijriDate   String?
  eventType   String   @default("custom")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("calendar_events")
}

model AdhkarProgress {
  id         String   @id @default(cuid())
  userId     String
  adhkarId   String
  adhkarName String
  category   String
  count      Int      @default(0)
  target     Int
  date       DateTime
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, adhkarId, date])
  @@index([userId, date])
  @@index([userId, category, date])
  @@map("adhkar_progress")
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  focusDuration      Int      @default(25)
  shortBreakDuration Int      @default(5)
  longBreakDuration  Int      @default(15)
  autoStartBreaks    Boolean  @default(false)
  autoStartFocus     Boolean  @default(false)
  enableMusic        Boolean  @default(true)
  musicVolume        Int      @default(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_settings")
}

model TwoFactorToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([token])
  @@index([userId])
  @@map("two_factor_tokens")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EnergyLevel {
  LOW
  MEDIUM
  HIGH
}

enum HabitFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum QuoteCategory {
  GENERAL
  PRODUCTIVITY
  PATIENCE
  GRATITUDE
  PRAYER
  KNOWLEDGE
  FAMILY
  CHARACTER
}

enum PrayerName {
  FAJR
  DHUHR
  ASR
  MAGHRIB
  ISHA
}

enum GoalCategory {
  IBADAH
  KNOWLEDGE
  FAMILY
  WORK
  HEALTH
  COMMUNITY
  PERSONAL
}

enum GoalType {
  DUNYA
  AKHIRAH
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}
